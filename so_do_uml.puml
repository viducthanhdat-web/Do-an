@startuml AD01_DangNhap_PhanQuyen
title AD01 - Quy trình đăng nhập và phân quyền
skinparam monochrome true

|Người dùng|
start
:Nhập email trường (@*.edu.vn) và mật khẩu;
:Bấm Đăng nhập;

|Frontend Web|
:Kiểm tra tính hợp lệ dữ liệu nhập;
if (Dữ liệu hợp lệ?) then (Không)
  :Báo lỗi định dạng;
  stop
else (Có)
  :Gửi yêu cầu xác thực sang Firebase Auth;
endif

|Firebase Auth|
if (Xác thực thành công?) then (Không)
  :Báo lỗi sai thông tin;
  |Frontend Web|
  :Hiển thị thông báo đăng nhập thất bại;
  stop
else (Có)
  :Cấp JWT ID Token chứa Claims (role);
endif

|Cloud Firestore|
:Đọc thông tin hồ sơ users/{userId};

|Frontend Web|
if (Trạng thái tài khoản?) then (Bị khóa)
  :Cưỡng chế đăng xuất;
  :Báo tài khoản bị khóa;
  stop
else (Hoạt động)
  if (Vai trò (role)?) then (Admin)
