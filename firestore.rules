rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Global Safety Net
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'viducthanhdat3@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints
    // -------------------------------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'role']) &&
             data.keys().hasOnly(['uid', 'displayName', 'email', 'role', 'trustScore', 'photoURL', 'phoneNumber', 'createdAt']) &&
             data.uid == request.auth.uid &&
             (data.email == null || data.email == request.auth.token.email || data.email == "") &&
             data.role in ['user', 'admin'] &&
             (data.trustScore == null || (data.trustScore is number && data.trustScore >= 0 && data.trustScore <= 100));
    }

    function isValidItem(data) {
      return data.keys().hasAll(['title', 'category', 'sellerId', 'status', 'createdAt']) &&
             data.keys().hasOnly(['id', 'title', 'description', 'category', 'subject', 'condition', 'price', 'sellerId', 'sellerName', 'status', 'imageUrl', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() <= 100 &&
             data.category in ['Textbook', 'Equipment', 'Note', 'Other'] &&
             data.sellerId == request.auth.uid &&
             data.status in ['available', 'held', 'exchanged'] &&
             (data.price == null || (data.price is number && data.price >= 0)) &&
             data.createdAt == request.time;
    }

    function isValidHold(data) {
      return data.keys().hasAll(['itemId', 'requesterId', 'sellerId', 'expiresAt', 'status', 'createdAt']) &&
             data.keys().hasOnly(['id', 'itemId', 'requesterId', 'requesterName', 'sellerId', 'expiresAt', 'meetupPoint', 'status', 'createdAt']) &&
             data.requesterId == request.auth.uid &&
             data.requesterId != data.sellerId &&
             data.status in ['active', 'completed', 'cancelled', 'expired'] &&
             data.createdAt == request.time;
    }

    // -------------------------------------------------------------------------
    // Collection Matches
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isVerified() && isValidId(userId) && isValidUser(incoming()) && incoming().role == 'user';
      allow update: if isVerified() && (
        (isOwner(userId) && isValidUser(incoming()) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if true; // Cho phép mọi người xem danh sách để tăng tính trải nghiệm
      allow create: if isVerified() && isValidId(itemId) && isValidItem(incoming());
      allow update: if isVerified() && (
        (isOwner(existing().sellerId) && isValidItem(incoming()) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'subject', 'condition', 'price', 'imageUrl', 'status', 'updatedAt']) &&
         incoming().updatedAt == request.time) ||
        // Cho phép đổi trạng thái sang 'held' (logic này được dùng khi sinh viên đặt giữ đồ)
        (incoming().status == 'held' && existing().status == 'available' && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
         incoming().updatedAt == request.time) ||
        isAdmin()
      );
      allow delete: if isVerified() && (isOwner(existing().sellerId) || isAdmin());
    }

    match /holds/{holdId} {
      allow read: if isSignedIn() && (isOwner(resource.data.requesterId) || isOwner(resource.data.sellerId) || isAdmin());
      allow create: if isVerified() && isValidId(holdId) && isValidHold(incoming()) &&
                    get(/databases/$(database)/documents/items/$(incoming().itemId)).data.status == 'available';
      allow update: if isVerified() && (
        ( (isOwner(existing().requesterId) || isOwner(existing().sellerId)) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
          incoming().status in ['completed', 'cancelled'] ) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
  }
}
