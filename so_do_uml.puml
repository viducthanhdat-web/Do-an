@enduml


@startuml AD02_DangTin_KiemDuyet
title AD02 - Quy trình đăng tin và kiểm duyệt
skinparam monochrome true

|Người bán|
start
:Nhập thông tin vật phẩm và chọn ảnh;
:Bấm Đăng tin;

|Frontend Web|
:Tải ảnh lên Firebase Storage;
:Ghi bài viết mới vào Firestore (status='available', moderation='pending');

|Người bán|
:Nhận thông báo tin đang chờ duyệt;

|Admin|
:Mở danh sách bài chờ duyệt;
:Kiểm tra nội dung và hình ảnh;

if (Hợp lệ theo quy chế?) then (Hợp lệ)
  :Bấm Phê duyệt;
  |Cloud Firestore|
  :Cập nhật moderation_status = 'approved';
  :Ghi log kiểm duyệt;
else (Vi phạm)
  |Admin|
  :Nhập lý do từ chối;
  :Bấm Từ chối;
  |Cloud Firestore|
  :Cập nhật moderation_status = 'rejected';
  :Ghi log kiểm duyệt kèm lý do;
endif
stop
@enduml


@startuml AD03_TimKiem_LuaChon
title AD03 - Quy trình tìm kiếm và lựa chọn vật phẩm
skinparam monochrome true

|Người nhận|
start
:Truy cập sàn giao dịch;
:Nhập từ khóa và chọn bộ lọc (môn học, đồ 0đ);

|Cloud Firestore|
:Truy vấn các bài đăng (moderation='approved', status='available');
:Trả về danh sách kết quả;

|Frontend Web|
if (Có kết quả?) then (Không)
  :Hiển thị thông báo không tìm thấy kết quả;
  stop
else (Có)
  :Hiển thị danh sách vật phẩm;
endif

|Người nhận|
:Chọn xem chi tiết một vật phẩm;
if (Quyết định nhận/mua?) then (Không)
  :Quay lại tìm kiếm;
  stop
else (Có)
  :Bấm Giữ chỗ món đồ;
endif
stop
@enduml


@startuml AD04_GiuChoVatPham
title AD04 - Quy trình giữ chỗ vật phẩm
skinparam monochrome true

|Người nhận|
start
:Bấm Giữ chỗ (chọn thời hạn 24h/48h);

|Cloud Functions|
:Xác thực người dùng;
:Đọc điểm tín nhiệm của người nhận;

if (current_trust_score >= 50?) then (Không)
  :Báo lỗi điểm tín nhiệm thấp, bị khóa quyền;
  stop
else (Có)
  :Mở Firestore Transaction;
endif

|Cloud Firestore|
:Đọc Document items/{itemId};

|Cloud Functions|
if (status == 'available' && active_hold_id == null && seller_id != requesterId?) then (Không hợp lệ)
  :Rollback Transaction;
  :Báo lỗi không thể giữ chỗ;
  stop
else (Hợp lệ)
  :Tạo Document holds (status='active', expiresAt=now+duration);
  :Cập nhật items (status='held', active_hold_id=holdId);
  :Commit Transaction;
endif

|Frontend Web|
:Hiển thị thông báo Giữ chỗ thành công;
:Đếm ngược thời gian và chuyển sang hẹn gặp;
stop
@enduml


@startuml AD05_XuLy_RaceCondition
title AD05 - Quy trình xử lý Race Condition khi hai người cùng giữ chỗ
skinparam monochrome true

|Sinh viên A|
start
:Bấm Giữ chỗ (t);

|Sinh viên B|
start
:Bấm Giữ chỗ (t + 1ms);

|Cloud Functions|
fork
  :Transaction A nhận yêu cầu;
fork again
  :Transaction B nhận yêu cầu;
end fork

|Cloud Firestore|
:Transaction A và B cùng đọc items/{itemId} (Đều thấy: AVAILABLE, Version: 1);

if (Commit nào đến trước?) then (Transaction A đến trước)
  :Chấp thuận Commit A;
  :Chuyển items sang HELD (Version: 2);
  |Sinh viên A|
  :Thông báo "Giữ chỗ THÀNH CÔNG";
  stop
else (Transaction B đến sau)
endif

|Cloud Firestore|
:Phát hiện xung đột phiên bản (Version 1 != 2);
:Từ chối Commit B và kích hoạt Retry tự động;

|Cloud Functions|
:Transaction B đọc lại Document items/{itemId};
:Thấy trạng thái mới: HELD;
:Kiểm tra thất bại (status != available);
:Rollback Transaction B;

|Sinh viên B|
:Thông báo "Món đồ đã được người khác giữ trước";
stop
@enduml


@startuml AD06_HenGap_HoanTatGiaoDich
title AD06 - Quy trình hẹn gặp và hoàn tất giao dịch
skinparam monochrome true

|Người nhận|
start
:Đề xuất thời gian và điểm hẹn tại trường;

|Người bán|
:Xem đề xuất lịch hẹn;
if (Đồng ý?) then (Không)
  :Đề xuất lại thời gian khác;
  detach
else (Đồng ý)
  :Bấm Chấp nhận lịch hẹn;
endif

:Hai bên đến điểm hẹn gặp mặt;
|Người nhận|
:Kiểm tra tình trạng sách/thiết bị thực tế;

if (Đồng ý nhận?) then (Không)
  :Hủy giao dịch tại chỗ;
  stop
else (Đồng ý)
  |Người bán|
  :Bấm Xác nhận bàn giao thành công;
  
  |Cloud Functions|
  :Chạy Transaction hoàn tất:
  - holds.status = 'converted'
  - items.status = 'completed'
  - items.active_hold_id = null
  - Tạo transactions hoàn tất
  - Cộng +5 điểm tín nhiệm cho 2 bên;
  
  |Frontend Web|
  :Báo giao dịch thành công cho cả hai sinh viên;
  stop
endif
@enduml


@startuml AD07_TuDongGiaiPhong_Hold
title AD07 - Quy trình tự động giải phóng Hold hết hạn
skinparam monochrome true

|Cloud Scheduler|
start
:Kích hoạt Cronjob định kỳ mỗi 5 phút;

|Cloud Functions|
:Quét các Hold có status == 'active' và expires_at <= now;

if (Có Hold quá hạn?) then (Không)
  :Kết thúc tác vụ;
  stop
else (Có)
  repeat
    :Lấy bản ghi Hold quá hạn tiếp theo;
    |Cloud Firestore|
    :Đọc items/{itemId};
    |Cloud Functions|
    :Đánh dấu holds.status = 'expired';
    if (item.active_hold_id == hold.id?) then (Khớp)
      :Thêm lệnh mở khóa item vào Batch (status='available', active_hold_id=null);
    else (Không khớp)
      :Bỏ qua không cập nhật item;
    endif
    :Thêm lệnh trừ 10 điểm uy tín vào Batch;
    :Thêm lệnh ghi log trust_history vào Batch;
  repeat while (Còn bản ghi?) is (Còn) not (Hết)
  
  :Commit toàn bộ Batch;
  stop
endif
@enduml


@startuml AD08_CapNhat_TrustScore
title AD08 - Quy trình cập nhật Trust Score
skinparam monochrome true

|Hệ thống|
start
:Phát sinh sự kiện (Hoàn tất giao dịch / Hủy / Quá hạn / Bùng hẹn);

|Cloud Functions|
:Đọc điểm hiện tại từ users/{userId};
:Tính newScore = current_trust_score + changeAmount;
:Ghi log chi tiết vào subcollection trust_history;

if (newScore < 50?) then (Có)
  :Gán trạng thái status = 'suspended' (khóa quyền giữ chỗ);
else (Không)
  :Duy trì trạng thái bình thường;
endif

|Cloud Firestore|
:Cập nhật users/{userId};

|Frontend Web|
:Cập nhật hiển thị điểm uy tín mới cho sinh viên;
stop
@enduml
