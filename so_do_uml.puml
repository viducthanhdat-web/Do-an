@startuml SD01_DangNhap_XacThuc
title SD01 - Đăng nhập và xác thực người dùng
skinparam monochrome true
autonumber

actor "Người dùng" as User
participant "Web Client" as Client
participant "Firebase Auth" as Auth
participant "Cloud Firestore" as DB

User -> Client: Nhập email trường & mật khẩu
Client -> Auth: signInWithEmailAndPassword(email, password)

alt Xác thực thành công
    Auth --> Client: UserCredential (UID, ID Token kèm Claims)
    Client -> DB: getDoc(users/{userId})
    DB --> Client: Dữ liệu tài khoản (status, role, trust_score)
    
    alt status == 'active'
        Client --> User: Điều hướng vào hệ thống
    else status == 'banned' hoặc 'suspended'
        Client -> Auth: signOut()
        Client --> User: Báo tài khoản bị khóa
    end
else Xác thực thất bại
    Auth --> Client: Lỗi xác thực
    Client --> User: Báo sai email hoặc mật khẩu
end
@enduml


@startuml SD02_DangTinVatPham
title SD02 - Đăng tin vật phẩm
skinparam monochrome true
autonumber

actor "Người bán" as Seller
participant "Web Client" as Client
participant "Firebase Storage" as Storage
participant "Cloud Firestore" as DB

Seller -> Client: Nhập thông tin vật phẩm & chọn ảnh
Client -> Storage: uploadBytes(file)
Storage --> Client: Trả về downloadURL

Client -> DB: addDoc(items, data) [status='available', moderation='pending']

alt Ghi dữ liệu thành công
    DB --> Client: Trả về itemId
    Client --> Seller: Báo đăng tin thành công (chờ duyệt)
else Lỗi phân quyền / Dữ liệu sai
    DB --> Client: Báo lỗi Permission Denied
    Client --> Seller: Báo đăng tin thất bại
end
@enduml


@startuml SD03_KiemDuyetBaiDang
title SD03 - Kiểm duyệt bài đăng bởi Admin
skinparam monochrome true
autonumber

actor "Admin" as Admin
participant "Web Client" as Client
participant "Cloud Firestore" as DB

Admin -> Client: Mở danh sách bài chờ duyệt
Client -> DB: getDocs(items where moderation_status == 'pending')
DB --> Client: Danh sách bài đăng

alt Phê duyệt bài đăng
    Admin -> Client: Chọn Duyệt bài
    Client -> DB: updateDoc(items/{id}, moderation_status='approved')
    Client -> DB: addDoc(items/{id}/moderation_logs, action='approve')
    DB --> Client: Xác nhận cập nhật
    Client --> Admin: Báo duyệt bài thành công
else Từ chối bài đăng
    Admin -> Client: Chọn Từ chối (nhập lý do)
    Client -> DB: updateDoc(items/{id}, moderation_status='rejected')
    Client -> DB: addDoc(items/{id}/moderation_logs, action='reject', reason)
    DB --> Client: Xác nhận cập nhật
    Client --> Admin: Báo đã từ chối bài đăng
end
@enduml


@startuml SD04_TimKiem_LocVatPham
title SD04 - Tìm kiếm và lọc vật phẩm
skinparam monochrome true
autonumber

actor "Người nhận" as User
participant "Web Client" as Client
participant "Cloud Firestore" as DB

User -> Client: Nhập từ khóa, chọn môn học/danh mục
Client -> DB: getDocs(query: moderation='approved', status='available', category)
DB --> Client: Danh sách vật phẩm phù hợp
Client --> User: Hiển thị kết quả tìm kiếm
@enduml


@startuml SD05_GiuChoVatPham
title SD05 - Giữ chỗ vật phẩm (Hold 24–48 giờ)
skinparam monochrome true
autonumber

actor "Người nhận" as Req
participant "Web Client" as Client
participant "Cloud Functions" as CF
participant "Cloud Firestore" as DB

Req -> Client: Bấm Giữ chỗ (chọn 24h hoặc 48h)
Client -> CF: createHoldOrder(itemId, duration)

CF -> DB: get(users/{requesterId})
DB --> CF: current_trust_score

alt Điểm uy tín < 50
    CF --> Client: Lỗi điểm uy tín thấp (< 50)
    Client --> Req: Báo không đủ điều kiện giữ chỗ
else Điểm uy tín >= 50
    CF -> DB: runTransaction()
    CF -> DB: transaction.get(items/{itemId})
    DB --> CF: itemData
    
    alt item_status == 'available' && active_hold_id == null && seller_id != requesterId
        CF -> DB: transaction.set(holds/{holdId}, data) [status='active', expiresAt]
        CF -> DB: transaction.update(items/{itemId}, [status='held', active_hold_id=holdId])
        DB --> CF: Commit thành công
        CF --> Client: Giữ chỗ thành công
        Client --> Req: Thông báo giữ chỗ thành công
    else Vật phẩm đã bị giữ hoặc tự giữ đồ của mình
        CF -> DB: Rollback transaction
        CF --> Client: Lỗi không thể giữ chỗ
        Client --> Req: Thông báo giữ chỗ thất bại
    end
end
@enduml


@startuml SD06_RaceCondition_Concurrency
title SD06 - Hai người cùng giữ chỗ một vật phẩm (Race Condition)
skinparam monochrome true
autonumber

actor "Sinh viên A" as UserA
participant "Client A" as ClientA
participant "Cloud Function A" as CFA
participant "Firestore Engine" as DB
participant "Cloud Function B" as CFB
participant "Client B" as ClientB
actor "Sinh viên B" as UserB

UserA -> ClientA: Bấm Giữ chỗ (t = 0s)
UserB -> ClientB: Bấm Giữ chỗ (t = 0.001s)

ClientA -> CFA: createHoldOrder(itemId)
ClientB -> CFB: createHoldOrder(itemId)

CFA -> DB: Transaction A: get(items/{itemId})
CFB -> DB: Transaction B: get(items/{itemId})
DB --> CFA: Snapshot A (Status: AVAILABLE, Version: 1)
DB --> CFB: Snapshot B (Status: AVAILABLE, Version: 1)

CFA -> DB: Transaction A: Commit [status='held', active_hold_id=HoldA]
DB --> CFA: Commit A thành công (Version tăng lên: 2)
CFA --> ClientA: Báo giữ chỗ thành công
ClientA --> UserA: "Giữ chỗ thành công!"

CFB -> DB: Transaction B: Commit [status='held', active_hold_id=HoldB]
note over DB: Snapshot B đã cũ (Version 1 != 2)\nKích hoạt RETRY tự động

DB --> CFB: Yêu cầu chạy lại Transaction B
CFB -> DB: Transaction B (Retry): get(items/{itemId})
DB --> CFB: Snapshot mới (Status: HELD, active_hold_id=HoldA)

CFB -> CFB: Kiểm tra thất bại: item_status != 'available'
CFB -> DB: Rollback Transaction B
CFB --> ClientB: Báo lỗi "Vật phẩm đã được người khác giữ"
ClientB --> UserB: "Rất tiếc! Món đồ đã có người giữ trước."
@enduml


@startuml SD07_HenGap_XacNhanGiaoDich
title SD07 - Hẹn gặp và xác nhận giao dịch
skinparam monochrome true
autonumber

actor "Người nhận" as Buyer
participant "Client (Buyer)" as BuyerUI
participant "Client (Seller)" as SellerUI
actor "Người bán" as Seller
participant "Cloud Functions" as CF
participant "Cloud Firestore" as DB

Buyer -> BuyerUI: Đề xuất lịch hẹn (địa điểm, giờ hẹn)
BuyerUI -> DB: addDoc(meetups, [status='proposed'])

DB -> SellerUI: Thông báo đề xuất lịch hẹn
Seller -> SellerUI: Bấm Chấp nhận lịch hẹn
SellerUI -> DB: updateDoc(meetups, [status='confirmed'])

note over Buyer, Seller: Hai sinh viên gặp nhau tại trường, bàn giao sách

Seller -> SellerUI: Bấm Xác nhận bàn giao thành công
SellerUI -> CF: confirmTransaction(holdId, meetupId)

CF -> DB: runTransaction()
CF -> DB: update(holds/{id}, status='converted')
CF -> DB: update(items/{id}, [status='completed', active_hold_id=null])
CF -> DB: add(transactions, [status='completed'])
CF -> DB: update(users, trust_score += 5) (cả 2 bên)
CF -> DB: add(trust_history, +5) (cả 2 bên)
DB --> CF: Commit thành công

CF --> SellerUI: Báo hoàn tất (+5 điểm uy tín)
CF --> BuyerUI: Báo hoàn tất (+5 điểm uy tín)
@enduml


@startuml SD08_TuDongGiaiPhongHold
title SD08 - Tự động giải phóng vật phẩm khi Hold hết hạn
skinparam monochrome true
autonumber

participant "Cloud Scheduler" as Cron
participant "Cloud Functions" as CF
participant "Cloud Firestore" as DB

Cron -> CF: Kích hoạt định kỳ (mỗi 5 phút)
CF -> DB: getDocs(holds where status=='active' and expires_at <= now)
DB --> CF: Danh sách Hold quá hạn

alt Không có Hold quá hạn
    CF --> Cron: Kết thúc tác vụ
else Có Hold quá hạn
    loop Duyệt từng Hold quá hạn
        CF -> DB: getDoc(items/{itemId})
        DB --> CF: itemData
        
        alt item.active_hold_id == hold.id
            CF -> DB: batch.update(items/{itemId}, [status='available', active_hold_id=null])
        else Item đã chuyển sang Hold khác
            note over CF: Bỏ qua update item để tránh mở khóa nhầm
        end
        
        CF -> DB: batch.update(holds/{id}, [status='expired'])
        CF -> DB: batch.update(users/{requesterId}, trust_score -= 10)
        CF -> DB: batch.add(trust_history, -10 điểm)
    end
    
    CF -> DB: batch.commit()
    DB --> CF: Commit thành công
    CF --> Cron: Hoàn tất giải phóng
end
@enduml


@startuml SD09_CongTru_TrustScore
title SD09 - Cộng/trừ điểm tín nhiệm Trust Score
skinparam monochrome true
autonumber

participant "Sự kiện hệ thống" as Event
participant "Cloud Functions" as CF
participant "Cloud Firestore" as DB
participant "Web Client" as Client

Event -> CF: Kích hoạt cập nhật điểm (userId, changeAmount, eventType)
CF -> DB: runTransaction: get(users/{userId})
DB --> CF: current_trust_score

CF -> CF: newScore = current_trust_score + changeAmount
CF -> DB: update(users/{userId}, current_trust_score=newScore)
CF -> DB: add(users/{userId}/trust_history, [score_change, balance_after=newScore])

alt newScore < 50
    CF -> DB: update(users/{userId}, [status='suspended', hold_locked_until])
else newScore >= 50
    note over CF: Duy trì trạng thái bình thường
end

DB --> CF: Commit transaction
CF -> Client: Thông báo biến động điểm tín nhiệm
@enduml


